# Share whitespace defaults across editors and supported languages.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{rs,py,java,kt}]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[justfile]
indent_size = 4

[*.just]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{tf,hcl,yml,yaml,json,toml,js,ts,jsx,tsx,css,html}]
indent_size = 2
