#!/usr/bin/env bash
# The speech service, presented as something the router can start.
#
# The maestro-llamacpp router resolves a catalog entry's `runtime = "tts"` to a
# binary called `llama-server-tts` on the search path. That is the whole
# integration: the catalog says which runtime, the machine says where it is,
# and no Rust changes. See services/README.md.
#
# The interpreter is resolved at run time and overridable, never written into
# this file: the venv it defaults to is a fact about one machine.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
python="${MAESTRO_TTS_PYTHON:-${HOME}/chatterbox-local/.venv/bin/python}"

if [ ! -x "${python}" ]; then
  echo "llama-server-tts: no interpreter at '${python}'." >&2
  echo "Set MAESTRO_TTS_PYTHON to one with chatterbox installed." >&2
  # 78 is EX_CONFIG: the machine is not set up, rather than the model
  # failing to load. The router reports the exit status, so the two are
  # worth telling apart in a log.
  exit 78
fi

export PYTHONPATH="${here}${PYTHONPATH:+:${PYTHONPATH}}"
exec "${python}" -m maestro_speech.speech "$@"
